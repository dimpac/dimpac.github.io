---
import ArticleCard from '../components/ArticleCard.astro';
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisiblePosts } from '../utils/posts';

const posts = (await getVisiblePosts()).slice(0, 5);
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">Independent publication</p>
    <h1>{SITE.title}</h1>
    <p class="hero-deck">{SITE.description}</p>
    <p class="hero-intro">
      Essays and technical explorations of intelligence, knowledge systems, and the engineering boundaries that make uncertain systems reliable.
    </p>
    <div class="hero-links">
      <a class="text-link" href="/blog/">Browse all articles</a>
      <a class="text-link secondary" href={SITE.links.github} rel="me">GitHub</a>
    </div>
  </section>

  <section class="article-section shell" aria-labelledby="recent-heading">
    <div class="section-heading">
      <h2 id="recent-heading">Recent articles</h2>
      <span>{posts.length.toString().padStart(2, '0')}</span>
    </div>
    {posts.length > 0 ? (
      <div class="article-list">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    ) : (
      <p class="empty-state">New articles will appear here.</p>
    )}
  </section>
</BaseLayout>
