---
import { SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home', active: pathname === '/' },
  { href: '/blog/', label: 'Articles', active: pathname.startsWith('/blog/') },
  { href: '/about/', label: 'About', active: pathname.startsWith('/about/') },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="site-mark" href="/" aria-label={`${SITE.title}, home`}>
      <span aria-hidden="true">TDB</span>
      <span>{SITE.title}</span>
    </a>
    <div class="header-actions">
      <nav aria-label="Primary navigation">
        <ul>
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
